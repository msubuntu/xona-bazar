# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/xona_bazar

# JWT — production'da kuchli 64+ belgili random kalit ishlatish kerak!
# generatsiya: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Frontend URL (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Telegram bot
BOT_TOKEN=
BOT_USERNAME=

# Prod: webhook rejimi (HTTPS public URL). Bo'sh bo'lsa — long-poll (dev uchun).
# Masalan: https://xona-bazar-production.up.railway.app/telegram/webhook
BOT_WEBHOOK_URL=
# Webhook xavfsizlik kaliti (ixtiyoriy, 1-256 alfanumerik/birin '-' va '_')
BOT_WEBHOOK_SECRET=
